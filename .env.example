# Copy this file to .env and fill in your keys.
# The wallpaper plugin reads these at dev-server startup via Vite's loadEnv.

# HuggingFace Inference API — free tier, used for AI image generation
# Get yours at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here

# Unsplash — free, used for stock images (days > 1 month old)
# Register at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=...

# Pexels — free fallback if Unsplash fails
# Register at https://www.pexels.com/api/
PEXELS_API_KEY=...
